From: numcodecs contributors
Subject: [PATCH] Follow the version 2 bitshuffle rule when writing Blosc1 chunks

Format version 2 bit-shuffles a block only when its number of elements is a
multiple of 8, and stores it unshuffled otherwise. Blosc2 shuffles the largest
multiple-of-8 prefix instead, which C-Blosc 1.x decodes to wrong data.
---
diff -ruN a/blosc/blosc2.c b/blosc/blosc2.c
--- a/blosc/blosc2.c
+++ b/blosc/blosc2.c
@@ -1119,7 +1122,12 @@
           blosc2_shuffle(filters_meta[i] == 0 ? typesize : filters_meta[i], bsize, _src, _dest);
           break;
         case BLOSC_BITSHUFFLE:
-          if (blosc2_bitshuffle(typesize, bsize, _src, _dest) < 0) {
+          if (context->blosc1_format && ((bsize / typesize) % 8) != 0) {
+            // Format version 2 (Blosc1) only bit-shuffles blocks whose number of
+            // elements is a multiple of 8; other blocks are stored unshuffled.
+            memcpy(_dest, _src, (size_t)bsize);
+          }
+          else if (blosc2_bitshuffle(typesize, bsize, _src, _dest) < 0) {
             return NULL;
           }
           break;
