from collections.abc import Iterable
from typing import Any, overload

import numpy as np
import numpy.typing as npt

from .abc import Codec, CodecConfig
from .ndarray_like import BufferLike

def check_out_param(out: npt.NDArray[np.object_], n_items: int) -> npt.NDArray[np.object_]: ...

# VLenUTF8 and VLenBytes also accept a list (or other iterable) of str or bytes. VLenArray
# needs an object array: numpy would turn a list of equal-length arrays into a 2-D array.

class VLenUTF8(Codec):
    codec_id: str
    def __init__(self) -> None: ...
    def get_config(self) -> CodecConfig: ...
    def encode(self, buf: BufferLike | Iterable[str]) -> bytearray: ...
    @overload
    def decode(self, buf: BufferLike, out: None = None) -> npt.NDArray[np.object_]: ...
    @overload
    def decode[OutT: BufferLike](self, buf: BufferLike, out: OutT) -> OutT: ...

class VLenBytes(Codec):
    codec_id: str
    def __init__(self) -> None: ...
    def get_config(self) -> CodecConfig: ...
    def encode(self, buf: BufferLike | Iterable[bytes]) -> bytearray: ...
    @overload
    def decode(self, buf: BufferLike, out: None = None) -> npt.NDArray[np.object_]: ...
    @overload
    def decode[OutT: BufferLike](self, buf: BufferLike, out: OutT) -> OutT: ...

class VLenArrayConfig(CodecConfig):
    dtype: str

class VLenArray(Codec):
    codec_id: str
    dtype: np.dtype[Any]
    def __init__(self, dtype: npt.DTypeLike) -> None: ...
    def get_config(self) -> VLenArrayConfig: ...
    def encode(self, buf: BufferLike) -> bytearray: ...
    @overload
    def decode(self, buf: BufferLike, out: None = None) -> npt.NDArray[np.object_]: ...
    @overload
    def decode[OutT: BufferLike](self, buf: BufferLike, out: OutT) -> OutT: ...
